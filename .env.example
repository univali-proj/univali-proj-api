# Variáveis de ambiente do projeto. Aqui são inicializadas as variáveis que irão no settings (app/core/config.py)
# e que mudam dependendo do ambiente que está rodando o código. Use .env.local para variáveis de desenvolvimento,
# como o URL do PostgreSQL rodando na máquina. Variáveis secretas do Vercel devem ser usadas, com as mesmas chaves,
# para produção, usando os valores reais.

# Aplicação
APP_ENV=development
APP_NAME=Confitto API
SECRET_KEY="change-me-to-a-long-random-secret"

# Banco de dados
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/confitto-db"
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=confitto-db

# CORS
# Lista JSON de origens exatas (protocolo, domínio e porta), sem caminho ou barra final.
# Para o frontend local, acrescente a origem usada pelo servidor de desenvolvimento.
CORS_ORIGINS=["https://confitto.vercel.app"]